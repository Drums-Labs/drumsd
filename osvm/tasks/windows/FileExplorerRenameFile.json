{
 "id": "windows/FileExplorerRenameFile",
 "os": "windows",
 "instruction": "Rename draft.txt on the Desktop to final.txt.",
 "source": "WindowsAgentArena-style, domain file_explorer (WindowsAgentArena@eb220c4 evaluation_examples_windows)",
 "setup": [
  "Remove-Item -Force (Join-Path ([Environment]::GetFolderPath('Desktop')) 'final.txt') -ErrorAction SilentlyContinue; exit 0",
  "Set-Content (Join-Path ([Environment]::GetFolderPath('Desktop')) 'draft.txt') 'v1'"
 ],
 "check": [
  {
   "cmd": "if (Test-Path (Join-Path ([Environment]::GetFolderPath('Desktop')) 'final.txt')) { 'yes' } else { 'no' }",
   "equals": "yes"
  },
  {
   "cmd": "if (Test-Path (Join-Path ([Environment]::GetFolderPath('Desktop')) 'draft.txt')) { 'yes' } else { 'no' }",
   "equals": "no"
  }
 ],
 "oracle": [
  {
   "type": "powershell",
   "command": "Rename-Item (Join-Path ([Environment]::GetFolderPath('Desktop')) 'draft.txt') final.txt"
  }
 ],
 "oracle_kind": "shell",
 "requires": [],
 "max_steps": 15
}