{
 "id": "windows/CalcSaveCsv",
 "os": "windows",
 "instruction": "Create sales.csv in Documents whose first row is item,qty.",
 "source": "WindowsAgentArena-style, domain libreoffice_calc (WindowsAgentArena@eb220c4 evaluation_examples_windows)",
 "setup": [
  "Remove-Item -Force (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'sales.csv') -ErrorAction SilentlyContinue; exit 0"
 ],
 "check": [
  {
   "cmd": "@(Get-Content (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'sales.csv'))[0]",
   "equals": "item,qty"
  }
 ],
 "oracle": [
  {
   "type": "powershell",
   "command": "Set-Content (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'sales.csv') 'item,qty'"
  }
 ],
 "oracle_kind": "shell",
 "requires": [],
 "max_steps": 15
}