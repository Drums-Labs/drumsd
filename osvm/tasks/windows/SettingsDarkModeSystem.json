{
 "id": "windows/SettingsDarkModeSystem",
 "os": "windows",
 "instruction": "Switch Windows (taskbar and Start) to dark mode.",
 "source": "WindowsAgentArena-style, domain settings (WindowsAgentArena@eb220c4 evaluation_examples_windows)",
 "setup": [
  "Set-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' SystemUsesLightTheme 1"
 ],
 "check": [
  {
   "cmd": "(Get-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize').SystemUsesLightTheme",
   "equals": "0"
  }
 ],
 "oracle": [
  {
   "type": "powershell",
   "command": "Set-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' SystemUsesLightTheme 0"
  }
 ],
 "oracle_kind": "shell",
 "requires": [],
 "max_steps": 15
}