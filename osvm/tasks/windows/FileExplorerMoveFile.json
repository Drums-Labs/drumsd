{
 "id": "windows/FileExplorerMoveFile",
 "os": "windows",
 "instruction": "Move photo_list.txt from the Desktop to Documents.",
 "source": "WindowsAgentArena-style, domain file_explorer (WindowsAgentArena@eb220c4 evaluation_examples_windows)",
 "setup": [
  "Remove-Item -Force (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'photo_list.txt') -ErrorAction SilentlyContinue; exit 0",
  "Set-Content (Join-Path ([Environment]::GetFolderPath('Desktop')) 'photo_list.txt') 'a.jpg'"
 ],
 "check": [
  {
   "cmd": "Get-Content (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'photo_list.txt')",
   "equals": "a.jpg"
  },
  {
   "cmd": "if (Test-Path (Join-Path ([Environment]::GetFolderPath('Desktop')) 'photo_list.txt')) { 'yes' } else { 'no' }",
   "equals": "no"
  }
 ],
 "oracle": [
  {
   "type": "powershell",
   "command": "Move-Item (Join-Path ([Environment]::GetFolderPath('Desktop')) 'photo_list.txt') (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'photo_list.txt')"
  }
 ],
 "oracle_kind": "shell",
 "requires": [],
 "max_steps": 15
}