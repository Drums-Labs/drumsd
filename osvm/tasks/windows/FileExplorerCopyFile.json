{
 "id": "windows/FileExplorerCopyFile",
 "os": "windows",
 "instruction": "Copy budget.csv from Documents to the Desktop.",
 "source": "WindowsAgentArena-style, domain file_explorer (WindowsAgentArena@eb220c4 evaluation_examples_windows)",
 "setup": [
  "Remove-Item -Force (Join-Path ([Environment]::GetFolderPath('Desktop')) 'budget.csv') -ErrorAction SilentlyContinue; exit 0",
  "Set-Content (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'budget.csv') 'item,cost'"
 ],
 "check": [
  {
   "cmd": "Get-Content (Join-Path ([Environment]::GetFolderPath('Desktop')) 'budget.csv')",
   "equals": "item,cost"
  },
  {
   "cmd": "Get-Content (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'budget.csv')",
   "equals": "item,cost"
  }
 ],
 "oracle": [
  {
   "type": "powershell",
   "command": "Copy-Item (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'budget.csv') (Join-Path ([Environment]::GetFolderPath('Desktop')) 'budget.csv')"
  }
 ],
 "oracle_kind": "shell",
 "requires": [],
 "max_steps": 15
}