{
 "id": "windows/SettingsTaskbarLeft",
 "os": "windows",
 "instruction": "Align the taskbar icons to the left.",
 "source": "WindowsAgentArena-style, domain settings (WindowsAgentArena@eb220c4 evaluation_examples_windows)",
 "setup": [
  "Set-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced' TaskbarAl 1"
 ],
 "check": [
  {
   "cmd": "(Get-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced').TaskbarAl",
   "equals": "0"
  }
 ],
 "oracle": [
  {
   "type": "powershell",
   "command": "Set-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced' TaskbarAl 0"
  }
 ],
 "oracle_kind": "shell",
 "requires": [],
 "max_steps": 15
}