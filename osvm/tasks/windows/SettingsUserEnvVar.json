{
 "id": "windows/SettingsUserEnvVar",
 "os": "windows",
 "instruction": "Add a user environment variable PROJECT_HOME with value C:\\work.",
 "source": "WindowsAgentArena-style, domain settings (WindowsAgentArena@eb220c4 evaluation_examples_windows)",
 "setup": [
  "Remove-ItemProperty 'HKCU:\\Environment' PROJECT_HOME -ErrorAction SilentlyContinue; exit 0"
 ],
 "check": [
  {
   "cmd": "(Get-ItemProperty 'HKCU:\\Environment').PROJECT_HOME",
   "equals": "C:\\work"
  }
 ],
 "oracle": [
  {
   "type": "powershell",
   "command": "Set-ItemProperty 'HKCU:\\Environment' PROJECT_HOME 'C:\\work'"
  }
 ],
 "oracle_kind": "shell",
 "requires": [],
 "max_steps": 15
}