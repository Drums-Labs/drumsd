{
 "title": "drums-pool SLOs",
 "uid": "drums-pool-slo",
 "schemaVersion": 39,
 "time": {
  "from": "now-2h",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "type": "stat",
   "title": "Live desktops",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(pool_envs{status=\"live\"})",
     "legendFormat": "Live desktops",
     "refId": "Live desktops"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "stat",
   "title": "Valid-reward rate (5 min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
