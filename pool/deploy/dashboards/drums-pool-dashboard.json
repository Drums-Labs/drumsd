    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(pool_verify_total{valid=\"true\",checker_error=\"false\"}[5m])) / sum(rate(pool_verify_total[5m]))",
     "legendFormat": "Valid-reward rate (5 min)",
     "refId": "Valid-reward rate (5"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3
    }
