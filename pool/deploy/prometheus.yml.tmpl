global:
  scrape_interval: 5s
  evaluation_interval: 5s
rule_files: [__DIR__/alerts.yml]
alerting:
  alertmanagers:
  - static_configs: [{targets: ["127.0.0.1:9093"]}]
scrape_configs:
- job_name: drums-pool
  authorization: {credentials_file: __TOKEN__}
  static_configs: [{targets: ["127.0.0.1:7080"]}]
