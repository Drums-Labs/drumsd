  "/v1/metrics/reset": {
   "post": {
    "summary": "New metrics window",
    "description": "The closed window's ledger is written to the event log.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/v1/tasks": {
   "get": {
    "summary": "List OSWorld tasks",
    "description": "Tasks in the host's pinned OSWorld checkout: id, domain, instruction. Query: domain.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/v1/tasks/{id}": {
   "get": {
    "summary": "Get an OSWorld task",
    "description": "By id or unique prefix (>= 8 chars); adds _domain and _sha256 of the file.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "400": {
      "description": "ambiguous or short id"
     },
     "404": {
      "description": "no such task"
     }
    }
   }
  },
  "/v1/slots/{id}/verify": {
   "post": {
    "summary": "Verify (reward)",
    "description": "Waits for the episode's pending gate, runs the task's OSWorld checker (postconfig, getters, metric) and returns {score, valid, validity, gates, checker_error, episode, task_id, seconds}. valid is true only when every gate passed and the slot is ready; a score from any other episode is returned with valid=false.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "400": {
      "description": "no task / not an OSWorld task"
     },
     "409": {
      "description": "nothing running"
     }
    }
   }
  },
  "/v1/slots/{id}/task": {
   "post": {
    "summary": "Load a task",
    "description": "Run an OSWorld task's setup in this ready slot now and after every reset. On setup failure the slot is quarantined (422).",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "422": {
      "description": "setup failed"
     }
    },
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "task": {
          "type": "object"
         }
        },
        "required": [
         "task"
        ]
       }
      }
     }
    }
   }
  },
  "/v1/slots/{id}/metrics": {
   "get": {
    "summary": "Slot metrics",
    "description": "This slot's ledger (as /v1/metrics), lifetime, last op timings and attempts, and its share of the host cost by slot-seconds.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     },
     "code": {
      "type": "string",
      "description": "Machine-readable error code when present, e.g. not_quiescent"
     },
     "unstable": {
      "type": "array"
     },
     "quiescence": {
      "type": "object"
     }
    },
    "required": [
     "error"
    ]
   },
   "AdoptRequest": {
    "type": "object",
    "required": [
     "id",
     "slot"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "slot": {
      "type": "integer",
      "description": "slot number whose directory holds images + upper.snap + records"
     },
     "expected_state_hash": {
      "type": "string"
     }
    }
   },
   "CreateRequest": {
    "type": "object",
    "required": [
     "checkpoint"
    ],
    "properties": {
     "checkpoint": {
      "type": "string"
     },
     "task": {
      "$ref": "#/components/schemas/Task"
     }
    }
   },
   "Task": {
    "type": "object",
    "description": "Optional task: setup actions run after every restore, after the state-hash gate.",
    "properties": {
     "id": {
      "type": "string"
     },
     "setup": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Action"
      }
     }
    }
   },
   "Action": {
    "type": "object",
    "description": "One desktop action.",
    "oneOf": [
     {
      "type": "object",
      "required": [
       "type",
       "command"
      ],
      "properties": {
       "type": {
        "const": "execute"
       },
       "command": {
        "description": "argv list or shell string"
       },
       "shell": {
        "type": "boolean"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "type",
       "code"
      ],
      "properties": {
       "type": {
        "const": "pyautogui"
       },
       "code": {
        "type": "string",
        "description": "python statements; `pyautogui` is imported"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "type",
       "seconds"
      ],
      "properties": {
       "type": {
        "const": "sleep"
       },
       "seconds": {
        "type": "number",
        "maximum": 60
       }
      }
     }
    ]
   },
   "StepRequest": {
    "type": "object",
    "required": [
     "action"
    ],
    "properties": {
     "action": {
      "$ref": "#/components/schemas/Action"
     },
     "screenshot": {
      "type": "boolean",
      "default": false
     }
    }
   },
   "StepResult": {
    "type": "object",
    "properties": {
     "result": {
      "type": "object",
      "description": "guest server /execute reply"
     },
