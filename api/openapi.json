  "/v1/slots/{id}/capture": {
   "post": {
    "summary": "Capture (save)",
    "description": "Checkpoint the running slot (`capture --leave-running`: the tree is frozen for the dump, the upper layer is copied at CRIU's post-dump action, the tree continues) and adopt it as a new checkpoint with its own template server. Capture readiness: the dump happens only after the slot's tree shows no task exiting, no unreaped zombie and no process or thread starting or exiting for the window; a dump whose CRIU-seized tree differs from that sample, or whose processes exit in the source right after, is discarded (records kept under forgotten/) and retried. 409 with `code: not_quiescent` (and `unstable`, `quiescence`) when no good dump is possible in time: nothing is captured and the env stays ready. The checkpoint's `quiescence` field records every attempt.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Checkpoint"
        }
       }
      }
     },
     "404": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "500": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string"
         },
         "quiesce_timeout_s": {
          "type": "number",
          "description": "Capture readiness: wait at most this long (s) for a quiescent tree (default from the daemon config, 30)."
         },
         "quiesce_window_s": {
          "type": "number",
          "description": "Capture readiness: the quiet window (s) (default 1)."
         }
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Slot id, e.g. s100"
     }
    ]
   }
  },
  "/v1/slots/{id}/branch": {
   "post": {
    "summary": "Branch",
    "description": "Capture the slot's current state, then create `n` children from it concurrently. The parent keeps running its episode. Capture readiness: the dump happens only after the slot's tree shows no task exiting, no unreaped zombie and no process or thread starting or exiting for the window; a dump whose CRIU-seized tree differs from that sample, or whose processes exit in the source right after, is discarded (records kept under forgotten/) and retried. 409 with `code: not_quiescent` (and `unstable`, `quiescence`) when no good dump is possible in time: nothing is captured and the env stays ready. The checkpoint's `quiescence` field records every attempt.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BranchResult"
        }
       }
      }
     },
     "400": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "500": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/BranchRequest",
        "properties": {
         "quiesce_timeout_s": {
          "type": "number",
          "description": "Capture readiness: wait at most this long (s) for a quiescent tree (default from the daemon config, 30)."
         },
         "quiesce_window_s": {
          "type": "number",
          "description": "Capture readiness: the quiet window (s) (default 1)."
         }
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Slot id, e.g. s100"
     }
