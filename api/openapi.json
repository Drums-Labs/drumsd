      "type": [
       "string",
       "null"
      ]
     },
     "episode": {
      "type": "integer"
     },
     "validity": {
      "$ref": "#/components/schemas/Validity"
     },
     "seconds": {
      "type": "number"
     }
    }
   },
   "BranchRequest": {
    "type": "object",
    "required": [
