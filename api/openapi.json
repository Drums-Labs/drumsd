  "/v1/slots/{id}/quiescent": {
   "post": {
    "summary": "Wait until quiescent",
    "description": "Block until the slot's process tree is safe to capture (no task exiting, no unreaped zombie, no process or thread starting or exiting for `window_s`). Holds the slot's operation lock while it waits. capture/branch do this themselves; this route waits without capturing. 409 `not_quiescent` on a timeout.",
    "responses": {
     "200": {
      "description": "The wait record: quiescent, waited_s, samples, window_s, timeout_s, restarts, processes, threads, unstable, seen, sample_ms_mean",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "404": {
      "description": "Error",
      "content": {
       "application/json": {
